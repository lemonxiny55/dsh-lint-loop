{
  "name": "dsh-lint-loop",
  "version": "0.6.0",
  "description": "The change-aware quality loop for DeepSeek Harness. Fix what the agent broke. Ignore what was already broken. Prove the change is clean.",
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "tsup",
    "prepublishOnly": "tsup"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "coding-agent",
    "quality-loop",
    "quality-gate",
    "regression-aware",
    "impacted-tests",
    "typecheck",
    "quality-receipt",
    "eslint",
    "biome",
    "ruff"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.1 <0.2.0-0 || >=0.2.0-0 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2",
    "@types/node": "^26.2.0",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lemonxiny55/dsh-lint-loop.git"
  },
  "homepage": "https://github.com/lemonxiny55/dsh-lint-loop",
  "bugs": {
    "url": "https://github.com/lemonxiny55/dsh-lint-loop/issues"
  },
  "packageManager": "pnpm@10.32.1"
}
